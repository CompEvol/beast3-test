<?xml version="1.0" encoding="UTF-8"?>
<!-- Not a project to build: check_packages.sh uses it to ask Maven for the jars of one
     BEAST 3 version (mvn dependency:build-classpath -Dbeast.version=...). -->
<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <groupId>io.github.compevol.test</groupId>
    <artifactId>package-check-launcher</artifactId>
    <version>1</version>
    <packaging>pom</packaging>
    <properties>
        <beast.version>2.8.0-SNAPSHOT</beast.version>
    </properties>
    <dependencies>
        <dependency>
            <groupId>io.github.compevol</groupId>
            <artifactId>beast-fx</artifactId>
            <version>${beast.version}</version>
        </dependency>
        <!-- headless JavaFX, to run BEAUti without a screen -->
        <dependency>
            <groupId>org.testfx</groupId>
            <artifactId>openjfx-monocle</artifactId>
            <version>21.0.2</version>
        </dependency>
    </dependencies>
</project>
