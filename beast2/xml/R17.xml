            <operator id="ORCInternalnodesOperator.c:dna" spec="orc.consoperators.InConstantDistanceOperator" clockModel="@OptimisedRelaxedClock.c:dna" rates="@ORCRates.c:dna" tree="@Tree.t:dna" twindowSize="0.005" weight="1.0">
                <kernel id="KernelDistribution$Bactrian.22" spec="operator.kernel.KernelDistribution$Bactrian"/>
            </operator>
            <operator id="ORCRatesRandomWalk.c:dna" spec="operator.kernel.BactrianRandomWalkOperator" parameter="@ORCRates.c:dna" scaleFactor="0.1" weight="1.0">
                <kernelDistribution id="KernelDistribution$Bactrian.23" spec="operator.kernel.KernelDistribution$Bactrian"/>
            </operator>
            <operator id="ORCRatesScale.c:dna" spec="kernel.BactrianScaleOperator" parameter="@ORCRates.c:dna" scaleFactor="0.5" upper="10.0" weight="1.0">
                <kernelDistribution id="KernelDistribution$Bactrian.24" spec="operator.kernel.KernelDistribution$Bactrian"/>
            </operator>
            <operator id="ORCSampleFromPriorOperator.rates.c:dna" spec="orc.operators.SampleFromPriorOperator" parameter="@ORCRates.c:dna" prior2="@ORCRatePriorDistribution.c:dna" weight="1.0"/>
        </operator>
        <operator id="ORCAdaptableOperatorSampler_NER.c:dna" spec="AdaptableOperatorSampler" weight="10.0">
            <tree idref="Tree.t:dna"/>
            <operator id="ORCNER_null.c:dna" spec="orc.operators.MetaNEROperator" rates="@ORCRates.c:dna" tree="@Tree.t:dna" weight="1.0"/>
            <operator id="ORCNER_dAE_dBE_dCE.c:dna" spec="orc.ner.NEROperator_dAE_dBE_dCE" rates="@ORCRates.c:dna" tree="@Tree.t:dna" weight="1.0"/>
            <metric id="RNNIMetric.0" spec="beastlabs.evolution.tree.RNNIMetric" taxonset="@TaxonSet.dna"/>
        </operator>
        <operator id="originScalerFBD.t:dna" spec="ScaleOperator" parameter="@originFBD.t:dna" weight="3.0"/>
        <operator id="divRateScalerFBD.t:dna" spec="ScaleOperator" parameter="@diversificationRateFBD.t:dna" weight="10.0"/>
        <operator id="turnoverScalerFBD.t:dna" spec="ScaleOperator" parameter="@turnoverFBD.t:dna" weight="10.0"/>
        <operator id="samplingPScalerFBD.t:dna" spec="ScaleOperator" parameter="@samplingProportionFBD.t:dna" weight="10.0"/>
        <operator id="LeafToSAFBD.t:dna" spec="sa.evolution.operators.LeafToSampledAncestorJump" tree="@Tree.t:dna" weight="10.0"/>
        <operator id="SAWilsonBaldingFBD.t:dna" spec="sa.evolution.operators.SAWilsonBalding" tree="@Tree.t:dna" weight="10.0"/>
        <operator id="SAWideFBD.t:dna" spec="sa.evolution.operators.SAExchange" isNarrow="false" tree="@Tree.t:dna" weight="10.0"/>
        <operator id="SANarrowFBD.t:dna" spec="sa.evolution.operators.SAExchange" tree="@Tree.t:dna" weight="10.0"/>
        <operator id="SAUniformOperatorFBD.t:dna" spec="sa.evolution.operators.SAUniform" tree="@Tree.t:dna" weight="20.0"/>
        <operator id="SATreeRootScalerFBD.t:dna" spec="sa.evolution.operators.SAScaleOperator" rootOnly="true" scaleFactor="0.95" tree="@Tree.t:dna" weight="1.0"/>
        <operator id="SATreeScalerFBD.t:dna" spec="sa.evolution.operators.SAScaleOperator" scaleFactor="0.95" tree="@Tree.t:dna" weight="3.0"/>
        <logger id="tracelog" spec="Logger" fileName="$(filebase).log" logEvery="4000" model="@posterior" sanitiseHeaders="true" sort="smart">
            <log idref="posterior"/>
            <log idref="likelihood"/>
            <log idref="prior"/>
            <log idref="treeLikelihood.dna"/>
            <log id="TreeHeight.t:dna" spec="beast.base.evolution.tree.TreeStatLogger" tree="@Tree.t:dna"/>
            <log idref="RevJump.s:dna"/>
            <log idref="BMT_ModelIndicator.s:dna"/>
            <log idref="BMT_gammaShape.s:dna"/>
            <log idref="BMT_ProportionInvariable.s:dna"/>
            <log idref="hasGammaRates.s:dna"/>
