                            <parameter id="RealParameter.2" spec="parameter.RealParameter" estimate="false" name="M">1.0</parameter>
                        </LogNormal>
                        <parameter id="ORCucldMean.c:dna" spec="parameter.RealParameter" estimate="false" name="clock.rate">1.0</parameter>
                    </branchRateModel>
                </distribution>
            </distribution>
        </distribution>
        <operator id="BMT_ModelTestOperator.s:dna" spec="bmodeltest.evolution.operators.BMTMergeSplitOperator" modelIndicator="@BMT_ModelIndicator.s:dna" rates="@BMT_Rates.s:dna" substModel="@RevJump.s:dna" weight="1.0"/>
        <operator id="BMT_Ratescaler.s:dna" spec="bmodeltest.evolution.operators.BMTExchangeOperator" delta="0.15" modelIndicator="@BMT_ModelIndicator.s:dna" rates="@BMT_Rates.s:dna" substModel="@RevJump.s:dna" weight="1.0"/>
        <operator id="BMT_gammaShapeScaler.s:dna" spec="bmodeltest.evolution.operators.BMTScaleOperator" count="@hasGammaRates.s:dna" parameter="@BMT_gammaShape.s:dna" scaleFactor="0.5" weight="0.5"/>
        <operator id="BMT_ProportionInvariableScaler.s:dna" spec="bmodeltest.evolution.operators.BMTScaleOperator" count="@hasInvariableSites.s:dna" parameter="@BMT_ProportionInvariable.s:dna" scaleFactor="0.5" weight="0.5"/>
        <operator id="BMT_hasGammaRatesFlipper.s:dna" spec="bmodeltest.evolution.operators.BMTBirthDeathOperator" count="@hasGammaRates.s:dna" rates="@BMT_gammaShape.s:dna" weight="0.1"/>
        <operator id="BMT_hasInvariableSitesFlipper.s:dna" spec="bmodeltest.evolution.operators.BMTBirthDeathOperator" count="@hasInvariableSites.s:dna" rates="@BMT_ProportionInvariable.s:dna" weight="0.1"/>
        <operator id="BMT_FreqsFlipOperator.s:dna" spec="operator.BitFlipOperator" parameter="@hasEqualFreqs.s:dna" weight="0.1"/>
        <operator id="BMT_FrequenciesExchanger.s:dna" spec="operator.kernel.BactrianDeltaExchangeOperator" delta="0.01" weight="0.2">
            <parameter idref="BMT_frequencies.s:dna"/>
        </operator>
        <operator id="ORCAdaptableOperatorSampler_sigma.c:dna" spec="AdaptableOperatorSampler" weight="3.0">
            <parameter idref="ORCsigma.c:dna"/>
            <operator id="ORCucldStdevScaler.c:dna" spec="orc.consoperators.UcldScalerOperator" distr="@ORCLogNormalDistributionModel.c:dna" rates="@ORCRates.c:dna" scaleFactor="0.5" stdev="@ORCsigma.c:dna" weight="1.0">
                <kernel id="KernelDistribution$Bactrian.17" spec="operator.kernel.KernelDistribution$Bactrian"/>
            </operator>
            <operator id="ORCUcldStdevRandomWalk.c:dna" spec="operator.kernel.BactrianRandomWalkOperator" parameter="@ORCsigma.c:dna" scaleFactor="0.1" weight="1.0">
                <kernelDistribution id="KernelDistribution$Bactrian.18" spec="operator.kernel.KernelDistribution$Bactrian"/>
            </operator>
            <operator id="ORCUcldStdevScale.c:dna" spec="kernel.BactrianScaleOperator" parameter="@ORCsigma.c:dna" scaleFactor="0.5" upper="10.0" weight="1.0">
                <kernelDistribution id="KernelDistribution$Bactrian.19" spec="operator.kernel.KernelDistribution$Bactrian"/>
            </operator>
            <operator id="ORCSampleFromPriorOperator_sigma.c:dna" spec="orc.operators.SampleFromPriorOperator" parameter="@ORCsigma.c:dna" prior2="@ORCsigmaPrior.c:dna" weight="1.0"/>
        </operator>
        <operator id="ORCAdaptableOperatorSampler_rates_root.c:dna" spec="AdaptableOperatorSampler" weight="1.0">
            <parameter idref="ORCRates.c:dna"/>
            <tree idref="Tree.t:dna"/>
            <operator id="ORCRootOperator1.c:dna" spec="orc.consoperators.SimpleDistance" clockModel="@OptimisedRelaxedClock.c:dna" rates="@ORCRates.c:dna" tree="@Tree.t:dna" twindowSize="0.005" weight="1.0">
                <kernel id="KernelDistribution$Bactrian.20" spec="operator.kernel.KernelDistribution$Bactrian"/>
            </operator>
            <operator id="ORCRootOperator2.c:dna" spec="orc.consoperators.SmallPulley" clockModel="@OptimisedRelaxedClock.c:dna" dwindowSize="0.005" rates="@ORCRates.c:dna" tree="@Tree.t:dna" weight="1.0">
                <kernel id="KernelDistribution$Bactrian.21" spec="operator.kernel.KernelDistribution$Bactrian"/>
            </operator>
        </operator>
        <operator id="ORCAdaptableOperatorSampler_rates_internal.c:dna" spec="AdaptableOperatorSampler" weight="20.0">
