    <run id="mcmc" spec="MCMC" chainLength="10000000">
        <state id="state" spec="State" storeEvery="5000">
            <tree id="Tree.t:protein" spec="beast.base.evolution.tree.Tree" name="stateNode">
                <taxonset id="TaxonSet.protein" spec="TaxonSet">
                    <alignment idref="protein"/>
                </taxonset>
            </tree>
            <parameter id="birthRate.t:protein" spec="parameter.RealParameter" lower="0.0" name="stateNode">1.0</parameter>
            <parameter id="gammaShape.s:protein" spec="parameter.RealParameter" lower="0.1" name="stateNode">1.0</parameter>
        </state>
        <init id="RandomTree.t:protein" spec="RandomTree" estimate="false" initial="@Tree.t:protein" taxa="@protein">
            <populationModel id="ConstantPopulation0.t:protein" spec="ConstantPopulation">
                <parameter id="randomPopSize.t:protein" spec="parameter.RealParameter" name="popSize">1.0</parameter>
            </populationModel>
        </init>
        <distribution id="posterior" spec="CompoundDistribution">
            <distribution id="prior" spec="CompoundDistribution">
                <distribution id="YuleModel.t:protein" spec="beast.base.evolution.speciation.YuleModel" birthDiffRate="@birthRate.t:protein" tree="@Tree.t:protein"/>
                <prior id="YuleBirthRatePrior.t:protein" name="distribution" x="@birthRate.t:protein">
                    <Gamma id="Gamma.11" name="distr">
                        <parameter id="RealParameter.50" spec="parameter.RealParameter" estimate="false" name="alpha">0.01</parameter>
                        <parameter id="RealParameter.51" spec="parameter.RealParameter" estimate="false" name="beta">100.0</parameter>
                    </Gamma>
                </prior>
                <prior id="GammaShapePrior.s:protein" name="distribution" x="@gammaShape.s:protein">
                    <Exponential id="Exponential.0" name="distr">
                        <parameter id="RealParameter.0" spec="parameter.RealParameter" estimate="false" name="mean">1.0</parameter>
                    </Exponential>
                </prior>
            </distribution>
            <distribution id="likelihood" spec="CompoundDistribution" useThreads="true">
                <distribution id="treeLikelihood.protein" spec="ThreadedTreeLikelihood" data="@protein" tree="@Tree.t:protein">
                    <siteModel id="SiteModel.s:protein" spec="SiteModel" gammaCategoryCount="4" shape="@gammaShape.s:protein">
                        <parameter id="mutationRate.s:protein" spec="parameter.RealParameter" estimate="false" lower="0.0" name="mutationRate">1.0</parameter>
                        <parameter id="proportionInvariant.s:protein" spec="parameter.RealParameter" estimate="false" lower="0.0" name="proportionInvariant" upper="1.0">0.0</parameter>
                        <substModel id="WAG.s:protein" spec="WAG"/>
                    </siteModel>
                    <branchRateModel id="StrictClock.c:protein" spec="beast.base.evolution.branchratemodel.StrictClockModel">
                        <parameter id="clockRate.c:protein" spec="parameter.RealParameter" estimate="false" lower="0.0" name="clock.rate">1.0</parameter>
                    </branchRateModel>
                </distribution>
            </distribution>
        </distribution>
        <operator id="YuleBirthRateScaler.t:protein" spec="kernel.BactrianScaleOperator" parameter="@birthRate.t:protein" upper="10.0" weight="3.0"/>
        <operator id="YuleModelTreeRootScaler.t:protein" spec="kernel.BactrianScaleOperator" rootOnly="true" scaleFactor="0.5" tree="@Tree.t:protein" upper="10.0" weight="3.0"/>
        <operator id="YuleModelUniformOperator.t:protein" spec="kernel.BactrianNodeOperator" tree="@Tree.t:protein" weight="30.0"/>
        <operator id="YuleModelSubtreeSlide.t:protein" spec="kernel.BactrianSubtreeSlide" tree="@Tree.t:protein" weight="15.0"/>
        <operator id="YuleModelNarrow.t:protein" spec="Exchange" tree="@Tree.t:protein" weight="15.0"/>
        <operator id="YuleModelWide.t:protein" spec="Exchange" isNarrow="false" tree="@Tree.t:protein" weight="3.0"/>
        <operator id="YuleModelWilsonBalding.t:protein" spec="WilsonBalding" tree="@Tree.t:protein" weight="3.0"/>
        <operator id="YuleModelBICEPSEpochTop.t:protein" spec="EpochFlexOperator" scaleFactor="0.1" tree="@Tree.t:protein" weight="2.0"/>
        <operator id="YuleModelBICEPSEpochAll.t:protein" spec="EpochFlexOperator" fromOldestTipOnly="false" scaleFactor="0.1" tree="@Tree.t:protein" weight="2.0"/>
        <operator id="YuleModelBICEPSTreeFlex.t:protein" spec="TreeStretchOperator" scaleFactor="0.01" tree="@Tree.t:protein" weight="2.0"/>
        <operator id="gammaShapeScaler.s:protein" spec="AdaptableOperatorSampler" weight="0.05">
            <parameter idref="gammaShape.s:protein"/>
            <operator id="AVMNOperator.protein" spec="kernel.AdaptableVarianceMultivariateNormalOperator" allowNonsense="true" beta="0.05" burnin="400" initial="800" weight="0.1">
                <transformations id="AVMNSumTransform.protein" spec="operator.kernel.Transform$LogConstrainedSumTransform"/>
                <transformations id="AVMNLogTransform.protein" spec="operator.kernel.Transform$LogTransform">
                    <f idref="gammaShape.s:protein"/>
                </transformations>
                <transformations id="AVMNNoTransform.protein" spec="operator.kernel.Transform$NoTransform">
                    <f idref="Tree.t:protein"/>
                </transformations>
            </operator>
            <operator id="gammaShapeScalerX.s:protein" spec="kernel.BactrianScaleOperator" parameter="@gammaShape.s:protein" scaleFactor="0.5" upper="10.0" weight="0.1"/>
        </operator>
        <logger id="tracelog" spec="Logger" fileName="$(filebase).log" logEvery="1000" model="@posterior" sanitiseHeaders="true" sort="smart">
            <log idref="posterior"/>
            <log idref="likelihood"/>
            <log idref="prior"/>
            <log idref="treeLikelihood.protein"/>
            <log id="TreeHeight.t:protein" spec="beast.base.evolution.tree.TreeStatLogger" tree="@Tree.t:protein"/>
            <log idref="YuleModel.t:protein"/>
            <log idref="birthRate.t:protein"/>
            <log idref="gammaShape.s:protein"/>
        </logger>
        <logger id="screenlog" spec="Logger" logEvery="1000">
            <log idref="posterior"/>
            <log idref="likelihood"/>
            <log idref="prior"/>
        </logger>
        <logger id="treelog.t:protein" spec="Logger" fileName="$(filebase)-$(tree).trees" logEvery="1000" mode="tree">
            <log id="TreeWithMetaDataLogger.t:protein" spec="beast.base.evolution.TreeWithMetaDataLogger" tree="@Tree.t:protein"/>
        </logger>
        <operatorschedule id="OperatorSchedule" spec="OperatorSchedule"/>
    </run>

</beast>
