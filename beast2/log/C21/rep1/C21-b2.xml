    <run id="mcmc" spec="MCMC" chainLength="10000000">
        <state id="state" spec="State" storeEvery="5000">
            <tree id="Tree.t:E15-binary" spec="beast.base.evolution.tree.Tree" name="stateNode">
                <taxonset id="TaxonSet.E15-binary" spec="TaxonSet">
                    <alignment idref="E15-binary"/>
                </taxonset>
            </tree>
            <parameter id="birthRate.t:E15-binary" spec="parameter.RealParameter" lower="0.0" name="stateNode">1.0</parameter>
        </state>
        <init id="RandomTree.t:E15-binary" spec="RandomTree" estimate="false" initial="@Tree.t:E15-binary" taxa="@E15-binary">
            <populationModel id="ConstantPopulation0.t:E15-binary" spec="ConstantPopulation">
                <parameter id="randomPopSize.t:E15-binary" spec="parameter.RealParameter" name="popSize">1.0</parameter>
            </populationModel>
        </init>
        <distribution id="posterior" spec="CompoundDistribution">
            <distribution id="prior" spec="CompoundDistribution">
                <distribution id="YuleModel.t:E15-binary" spec="beast.base.evolution.speciation.YuleModel" birthDiffRate="@birthRate.t:E15-binary" tree="@Tree.t:E15-binary"/>
                <prior id="YuleBirthRatePrior.t:E15-binary" name="distribution" x="@birthRate.t:E15-binary">
                    <Uniform id="Uniform.1" name="distr" upper="Infinity"/>
                </prior>
            </distribution>
            <distribution id="likelihood" spec="CompoundDistribution" useThreads="true">
                <distribution id="treeLikelihood.E15-binary" spec="ThreadedTreeLikelihood" data="@E15-binary" tree="@Tree.t:E15-binary">
                    <siteModel id="SiteModel.s:E15-binary" spec="SiteModel">
                        <parameter id="mutationRate.s:E15-binary" spec="parameter.RealParameter" estimate="false" lower="0.0" name="mutationRate">1.0</parameter>
                        <parameter id="gammaShape.s:E15-binary" spec="parameter.RealParameter" estimate="false" lower="0.1" name="shape">1.0</parameter>
                        <parameter id="proportionInvariant.s:E15-binary" spec="parameter.RealParameter" estimate="false" lower="0.0" name="proportionInvariant" upper="1.0">0.0</parameter>
                        <substModel id="MutationDeathModel.s:E15-binary" spec="MutationDeathModel">
                            <parameter id="deathprob.s:E15-binary" spec="parameter.RealParameter" estimate="false" lower="0.0" name="deathprob">0.1</parameter>
                            <frequencies id="freqs.s:E15-binary" spec="Frequencies">
                                <parameter id="RealParameter.0" spec="parameter.RealParameter" dimension="2" lower="0.0" name="frequencies">1.0 0.0</parameter>
                            </frequencies>
                        </substModel>
                    </siteModel>
                    <branchRateModel id="StrictClock.c:E15-binary" spec="beast.base.evolution.branchratemodel.StrictClockModel">
                        <parameter id="clockRate.c:E15-binary" spec="parameter.RealParameter" estimate="false" lower="0.0" name="clock.rate">1.0</parameter>
                    </branchRateModel>
                </distribution>
            </distribution>
        </distribution>
        <operator id="YuleBirthRateScaler.t:E15-binary" spec="kernel.BactrianScaleOperator" parameter="@birthRate.t:E15-binary" weight="3.0"/>
        <operator id="YuleModelTreeRootScaler.t:E15-binary" spec="kernel.BactrianScaleOperator" rootOnly="true" scaleFactor="0.5" tree="@Tree.t:E15-binary" weight="3.0"/>
        <operator id="YuleModelUniformOperator.t:E15-binary" spec="kernel.BactrianNodeOperator" tree="@Tree.t:E15-binary" weight="30.0"/>
        <operator id="YuleModelSubtreeSlide.t:E15-binary" spec="kernel.BactrianSubtreeSlide" tree="@Tree.t:E15-binary" weight="15.0"/>
        <operator id="YuleModelNarrow.t:E15-binary" spec="Exchange" tree="@Tree.t:E15-binary" weight="15.0"/>
        <operator id="YuleModelWide.t:E15-binary" spec="Exchange" isNarrow="false" tree="@Tree.t:E15-binary" weight="3.0"/>
        <operator id="YuleModelWilsonBalding.t:E15-binary" spec="WilsonBalding" tree="@Tree.t:E15-binary" weight="3.0"/>
        <operator id="YuleModelBICEPSEpochTop.t:E15-binary" spec="EpochFlexOperator" scaleFactor="0.1" tree="@Tree.t:E15-binary" weight="2.0"/>
        <operator id="YuleModelBICEPSEpochAll.t:E15-binary" spec="EpochFlexOperator" fromOldestTipOnly="false" scaleFactor="0.1" tree="@Tree.t:E15-binary" weight="2.0"/>
        <operator id="YuleModelBICEPSTreeFlex.t:E15-binary" spec="TreeStretchOperator" scaleFactor="0.01" tree="@Tree.t:E15-binary" weight="2.0"/>
        <logger id="tracelog" spec="Logger" fileName="$(filebase).log" logEvery="1000" model="@posterior" sanitiseHeaders="true" sort="smart">
            <log idref="posterior"/>
            <log idref="likelihood"/>
            <log idref="prior"/>
            <log idref="treeLikelihood.E15-binary"/>
            <log id="TreeHeight.t:E15-binary" spec="beast.base.evolution.tree.TreeStatLogger" tree="@Tree.t:E15-binary"/>
            <log idref="YuleModel.t:E15-binary"/>
            <log idref="birthRate.t:E15-binary"/>
        </logger>
        <logger id="screenlog" spec="Logger" logEvery="1000">
            <log idref="posterior"/>
            <log idref="likelihood"/>
            <log idref="prior"/>
        </logger>
        <logger id="treelog.t:E15-binary" spec="Logger" fileName="$(filebase)-$(tree).trees" logEvery="1000" mode="tree">
            <log id="TreeWithMetaDataLogger.t:E15-binary" spec="beast.base.evolution.TreeWithMetaDataLogger" tree="@Tree.t:E15-binary"/>
        </logger>
        <operatorschedule id="OperatorSchedule" spec="OperatorSchedule"/>
    </run>

