    <run id="mcmc" spec="MCMC" chainLength="10000000">
        <state id="state" spec="State" storeEvery="5000">
            <tree id="Tree.t:coding" spec="beast.base.evolution.tree.Tree" name="stateNode">
                <taxonset id="TaxonSet.coding" spec="TaxonSet">
                    <alignment id="coding" spec="FilteredAlignment" filter="2-457,660-896">
                        <data idref="primate-mtDNA"/>
                    </alignment>
                </taxonset>
            </tree>
            <parameter id="kappa.s:coding" spec="parameter.RealParameter" lower="0.0" name="stateNode">2.0</parameter>
            <parameter id="freqParameter.s:coding" spec="parameter.RealParameter" dimension="4" lower="0.0" name="stateNode" upper="1.0">0.25</parameter>
            <parameter id="gammaShape.s:coding" spec="parameter.RealParameter" lower="0.1" name="stateNode">1.0</parameter>
            <parameter id="clockRate.c:coding" spec="parameter.RealParameter" lower="0.0" name="stateNode">1.0</parameter>
            <parameter id="birthRateY.t:coding" spec="parameter.RealParameter" lower="0.0" name="stateNode">1.0</parameter>
        </state>
        <init id="RandomTree.t:1stpos" spec="RandomTree" estimate="false" initial="@Tree.t:coding">
            <taxa id="1stpos" spec="FilteredAlignment" data="@primate-mtDNA" filter="2-457\3,660-896\3"/>
            <populationModel id="ConstantPopulation0.t:1stpos" spec="ConstantPopulation">
                <parameter id="randomPopSize.t:1stpos" spec="parameter.RealParameter" name="popSize">1.0</parameter>
            </populationModel>
        </init>
        <distribution id="posterior" spec="CompoundDistribution">
            <distribution id="prior" spec="CompoundDistribution">
                <distribution id="CalibratedYuleModel.t:coding" spec="beast.base.evolution.speciation.CalibratedYuleModel" birthRate="@birthRateY.t:coding" tree="@Tree.t:coding"/>
                <prior id="CalibratedYuleBirthRatePrior.t:coding" name="distribution" x="@birthRateY.t:coding">
                    <LogNormal id="LogNormalDistributionModel.1" name="distr">
                        <parameter id="RealParameter.8" spec="parameter.RealParameter" estimate="false" name="M">1.0</parameter>
                        <parameter id="RealParameter.9" spec="parameter.RealParameter" estimate="false" lower="0.0" name="S" upper="5.0">1.25</parameter>
                    </LogNormal>
                </prior>
                <prior id="ClockPrior.c:coding" name="distribution" x="@clockRate.c:coding">
                    <LogNormal id="LogNormalDistributionModel.2" name="distr">
                        <parameter id="RealParameter.12" spec="parameter.RealParameter" estimate="false" name="M">1.0</parameter>
                        <parameter id="RealParameter.13" spec="parameter.RealParameter" estimate="false" lower="0.0" name="S" upper="5.0">1.25</parameter>
                    </LogNormal>
                </prior>
                <prior id="FrequenciesPrior.s:coding" name="distribution" x="@freqParameter.s:coding">
                    <distr id="Dirichlet.0" spec="distribution.Dirichlet">
                        <parameter id="RealParameter.7" spec="parameter.RealParameter" dimension="4" estimate="false" name="alpha">4.0 4.0 4.0 4.0</parameter>
                    </distr>
                </prior>
                <prior id="GammaShapePrior.s:coding" name="distribution" x="@gammaShape.s:coding">
                    <Exponential id="Exponential.0" name="distr">
                        <parameter id="RealParameter.0" spec="parameter.RealParameter" estimate="false" name="mean">1.0</parameter>
                    </Exponential>
                </prior>
                <prior id="KappaPrior.s:coding" name="distribution" x="@kappa.s:coding">
                    <LogNormal id="LogNormalDistributionModel.0" name="distr">
                        <parameter id="RealParameter.5" spec="parameter.RealParameter" estimate="false" name="M">1.0</parameter>
                        <parameter id="RealParameter.6" spec="parameter.RealParameter" estimate="false" name="S">1.25</parameter>
                    </LogNormal>
                </prior>
                <distribution id="human–chimp.prior" spec="beast.base.evolution.tree.MRCAPrior" monophyletic="true" tree="@Tree.t:coding">
                    <taxonset id="human–chimp" spec="TaxonSet">
                        <taxon id="Homo_sapiens" spec="Taxon"/>
                        <taxon id="Pan" spec="Taxon"/>
                    </taxonset>
                    <LogNormal id="LogNormalDistributionModel.3" name="distr">
                        <parameter id="RealParameter.14" spec="parameter.RealParameter" estimate="false" name="M">1.0</parameter>
                        <parameter id="RealParameter.15" spec="parameter.RealParameter" estimate="false" lower="0.0" name="S" upper="5.0">1.25</parameter>
                    </LogNormal>
                </distribution>
            </distribution>
            <distribution id="likelihood" spec="CompoundDistribution" useThreads="true">
                <distribution id="treeLikelihood.coding" spec="ThreadedTreeLikelihood" data="@coding" tree="@Tree.t:coding">
                    <siteModel id="SiteModel.s:coding" spec="SiteModel" gammaCategoryCount="4" shape="@gammaShape.s:coding">
                        <parameter id="mutationRate.s:coding" spec="parameter.RealParameter" estimate="false" lower="0.0" name="mutationRate">1.0</parameter>
                        <parameter id="proportionInvariant.s:coding" spec="parameter.RealParameter" estimate="false" lower="0.0" name="proportionInvariant" upper="1.0">0.0</parameter>
                        <substModel id="hky.s:coding" spec="HKY" kappa="@kappa.s:coding">
                            <frequencies id="estimatedFreqs.s:coding" spec="Frequencies" frequencies="@freqParameter.s:coding"/>
                        </substModel>
                    </siteModel>
                    <branchRateModel id="StrictClock.c:coding" spec="beast.base.evolution.branchratemodel.StrictClockModel" clock.rate="@clockRate.c:coding"/>
                </distribution>
                <distribution id="treeLikelihood.noncoding" spec="ThreadedTreeLikelihood" branchRateModel="@StrictClock.c:coding" siteModel="@SiteModel.s:coding" tree="@Tree.t:coding">
                    <data
id="noncoding"
spec="FilteredAlignment"
data="@primate-mtDNA"
filter="1,458-659,897-898"/>
                </distribution>
                <distribution id="treeLikelihood.1stpos" spec="ThreadedTreeLikelihood" branchRateModel="@StrictClock.c:coding" data="@1stpos" siteModel="@SiteModel.s:coding" tree="@Tree.t:coding"/>
                <distribution id="treeLikelihood.2ndpos" spec="ThreadedTreeLikelihood" branchRateModel="@StrictClock.c:coding" siteModel="@SiteModel.s:coding" tree="@Tree.t:coding">
                    <data
id="2ndpos"
spec="FilteredAlignment"
data="@primate-mtDNA"
filter="3-457\3,661-896\3"/>
                </distribution>
                <distribution id="treeLikelihood.3rdpos" spec="ThreadedTreeLikelihood" branchRateModel="@StrictClock.c:coding" siteModel="@SiteModel.s:coding" tree="@Tree.t:coding">
                    <data
id="3rdpos"
spec="FilteredAlignment"
data="@primate-mtDNA"
filter="4-457\3,662-.\3"/>
                </distribution>
            </distribution>
        </distribution>
        <operator id="KappaScaler.s:coding" spec="AdaptableOperatorSampler" weight="0.05">
            <parameter idref="kappa.s:coding"/>
            <operator id="AVMNOperator.coding" spec="kernel.AdaptableVarianceMultivariateNormalOperator" allowNonsense="true" beta="0.05" burnin="400" initial="800" weight="0.1">
                <transformations id="AVMNSumTransform.coding" spec="operator.kernel.Transform$LogConstrainedSumTransform">
                    <f idref="freqParameter.s:coding"/>
                </transformations>
                <transformations id="AVMNLogTransform.coding" spec="operator.kernel.Transform$LogTransform">
                    <f idref="kappa.s:coding"/>
                    <f idref="gammaShape.s:coding"/>
                    <f idref="clockRate.c:coding"/>
                </transformations>
                <transformations id="AVMNNoTransform.coding" spec="operator.kernel.Transform$NoTransform">
                    <f idref="Tree.t:coding"/>
                </transformations>
            </operator>
            <operator id="KappaScalerX.s:coding" spec="kernel.BactrianScaleOperator" parameter="@kappa.s:coding" scaleFactor="0.1" upper="10.0" weight="0.1"/>
        </operator>
        <operator id="FrequenciesExchanger.s:coding" spec="AdaptableOperatorSampler" weight="0.05">
            <parameter idref="freqParameter.s:coding"/>
            <operator idref="AVMNOperator.coding"/>
            <operator id="FrequenciesExchangerX.s:coding" spec="operator.kernel.BactrianDeltaExchangeOperator" delta="0.01" weight="0.1">
                <parameter idref="freqParameter.s:coding"/>
            </operator>
        </operator>
        <operator id="gammaShapeScaler.s:coding" spec="AdaptableOperatorSampler" weight="0.05">
            <parameter idref="gammaShape.s:coding"/>
