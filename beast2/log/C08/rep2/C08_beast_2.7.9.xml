            <operator id="gammaShapeScalerX.s:coding" spec="kernel.BactrianScaleOperator" parameter="@gammaShape.s:coding" scaleFactor="0.5" upper="10.0" weight="0.1"/>
        </operator>
        <operator id="StrictClockRateScaler.c:coding" spec="AdaptableOperatorSampler" weight="1.5">
            <parameter idref="clockRate.c:coding"/>
            <operator idref="AVMNOperator.coding"/>
            <operator id="StrictClockRateScalerX.c:coding" spec="kernel.BactrianScaleOperator" parameter="@clockRate.c:coding" upper="10.0" weight="3.0"/>
        </operator>
        <operator id="strictClockUpDownOperator.c:coding" spec="AdaptableOperatorSampler" weight="1.5">
            <parameter idref="clockRate.c:coding"/>
            <tree idref="Tree.t:coding"/>
            <operator idref="AVMNOperator.coding"/>
            <operator id="strictClockUpDownOperatorX.c:coding" spec="operator.kernel.BactrianUpDownOperator" scaleFactor="0.75" weight="3.0">
                <up idref="clockRate.c:coding"/>
                <down idref="Tree.t:coding"/>
            </operator>
        </operator>
        <operator id="CalibratedYuleModelBICEPSEpochTop.t:coding" spec="EpochFlexOperator" scaleFactor="0.1" tree="@Tree.t:coding" weight="2.0"/>
        <operator id="CalibratedYuleModelBICEPSEpochAll.t:coding" spec="EpochFlexOperator" fromOldestTipOnly="false" scaleFactor="0.1" tree="@Tree.t:coding" weight="2.0"/>
        <operator id="CalibratedYuleModelBICEPSTreeFlex.t:coding" spec="TreeStretchOperator" scaleFactor="0.01" tree="@Tree.t:coding" weight="2.0"/>
        <operator id="CalibratedYuleModelTreeRootScaler.t:coding" spec="kernel.BactrianScaleOperator" rootOnly="true" scaleFactor="0.1" tree="@Tree.t:coding" upper="10.0" weight="3.0"/>
        <operator id="CalibratedYuleModelUniformOperator.t:coding" spec="kernel.BactrianNodeOperator" tree="@Tree.t:coding" weight="30.0"/>
        <operator id="CalibratedYuleModelSubtreeSlide.t:coding" spec="kernel.BactrianSubtreeSlide" tree="@Tree.t:coding" weight="15.0"/>
        <operator id="CalibratedYuleModelNarrow.t:coding" spec="Exchange" tree="@Tree.t:coding" weight="15.0"/>
        <operator id="CalibratedYuleModelWide.t:coding" spec="Exchange" isNarrow="false" tree="@Tree.t:coding" weight="3.0"/>
        <operator id="CalibratedYuleModelWilsonBalding.t:coding" spec="WilsonBalding" tree="@Tree.t:coding" weight="3.0"/>
        <operator id="CalibratedYuleBirthRateScaler.t:coding" spec="kernel.BactrianScaleOperator" parameter="@birthRateY.t:coding" upper="10.0" weight="3.0"/>
        <logger id="tracelog" spec="Logger" fileName="$(filebase).log" logEvery="2000" model="@posterior" sanitiseHeaders="true" sort="smart">
            <log idref="posterior"/>
            <log idref="likelihood"/>
            <log idref="prior"/>
            <log idref="treeLikelihood.1stpos"/>
            <log idref="treeLikelihood.coding"/>
            <log id="TreeHeight.t:coding" spec="beast.base.evolution.tree.TreeStatLogger" tree="@Tree.t:coding"/>
            <log idref="treeLikelihood.2ndpos"/>
            <log idref="treeLikelihood.noncoding"/>
            <log idref="treeLikelihood.3rdpos"/>
            <log idref="kappa.s:coding"/>
            <log idref="freqParameter.s:coding"/>
            <log idref="gammaShape.s:coding"/>
            <log idref="clockRate.c:coding"/>
            <log idref="CalibratedYuleModel.t:coding"/>
            <log idref="birthRateY.t:coding"/>
            <log idref="human–chimp.prior"/>
        </logger>
        <logger id="screenlog" spec="Logger" logEvery="2000">
            <log idref="posterior"/>
            <log idref="likelihood"/>
            <log idref="prior"/>
        </logger>
        <logger id="treelog.t:coding" spec="Logger" fileName="$(filebase)-$(tree).trees" logEvery="2000" mode="tree">
            <log id="TreeWithMetaDataLogger.t:coding" spec="beast.base.evolution.TreeWithMetaDataLogger" tree="@Tree.t:coding"/>
        </logger>
        <operatorschedule id="OperatorSchedule" spec="OperatorSchedule"/>
    </run>

