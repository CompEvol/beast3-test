    <map name="TruncatedInt" >beast.base.spec.inference.distribution.TruncatedInt</map>

    <map name="LogNormal" >beast.base.spec.inference.distribution.LogNormal</map>

    <map name="Normal" >beast.base.spec.inference.distribution.Normal</map>

    <map name="Poisson" >beast.base.spec.inference.distribution.Poisson</map>

    <map name="NonNegativeUniform" >beast.base.spec.inference.distribution.NonNegativeUniform</map>

    <map name="Cauchy" >beast.base.spec.inference.distribution.Cauchy</map>

    <run id="mcmc" spec="MCMC" chainLength="20000000">
        <state id="state" spec="State" storeEvery="5000">
            <tree id="Tree.t:dna" spec="beast.base.evolution.tree.Tree" name="stateNode">
                <taxonset id="TaxonSet.dna" spec="TaxonSet">
                    <alignment idref="dna"/>
                </taxonset>
            </tree>
            <stateNode id="BMT_ModelIndicator.s:dna" spec="beast.base.spec.inference.parameter.IntScalarParam" domain="NonNegativeInt" value="5"/>
            <stateNode id="BMT_Rates.s:dna" spec="beast.base.spec.inference.parameter.RealVectorParam" dimension="6" domain="NonNegativeReal">1.0</stateNode>
            <stateNode id="BMT_gammaShape.s:dna" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="PositiveReal" value="1.0"/>
            <stateNode id="BMT_ProportionInvariable.s:dna" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="UnitInterval" value="0.1"/>
            <stateNode id="hasInvariableSites.s:dna" spec="beast.base.spec.inference.parameter.IntScalarParam" domain="NonNegativeInt" value="1"/>
            <stateNode id="hasGammaRates.s:dna" spec="beast.base.spec.inference.parameter.IntScalarParam" domain="NonNegativeInt" value="1"/>
            <stateNode id="hasEqualFreqs.s:dna" spec="beast.base.spec.inference.parameter.BoolScalarParam"/>
            <stateNode id="BMT_frequencies.s:dna" spec="beast.base.spec.inference.parameter.SimplexParam" dimension="4" domain="UnitInterval">0.25 0.25 0.25 0.25</stateNode>
            <stateNode id="ORCsigma.c:dna" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="PositiveReal" value="0.5"/>
            <stateNode id="ORCRates.c:dna" spec="beast.base.spec.inference.parameter.RealVectorParam" dimension="18" domain="PositiveReal">1.0</stateNode>
            <stateNode id="diversificationRateFBD.t:dna" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="Real" value="1.0"/>
            <stateNode id="turnoverFBD.t:dna" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="UnitInterval" value="0.5"/>
            <stateNode id="samplingProportionFBD.t:dna" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="UnitInterval" value="0.5"/>
            <stateNode id="originFBD.t:dna" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="PositiveReal" value="100.0"/>
        </state>
        <init id="RandomTree.t:dna" spec="beast.base.spec.evolution.tree.coalescent.RandomTree" estimate="false" initial="@Tree.t:dna" taxa="@dna">
            <populationModel id="ConstantPopulation0.t:dna" spec="beast.base.spec.evolution.tree.coalescent.ConstantPopulation">
                <popSize id="randomPopSize.t:dna" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="PositiveReal" value="1.0"/>
            </populationModel>
        </init>
        <distribution id="posterior" spec="CompoundDistribution">
            <distribution id="prior" spec="CompoundDistribution">
                <distribution id="FBD.t:dna" spec="sa.evolution.speciation.SABirthDeathModel" conditionOnRhoSampling="true" diversificationRate="@diversificationRateFBD.t:dna" origin="@originFBD.t:dna" samplingProportion="@samplingProportionFBD.t:dna" tree="@Tree.t:dna" turnover="@turnoverFBD.t:dna">
                    <removalProbability id="rFBD.t:dna" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="UnitInterval"/>
                    <rho id="rhoFBD.t:dna" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="UnitInterval" estimate="false" value="1.0"/>
                </distribution>
                <distribution id="BMT_GammaShapePrior.s:dna" spec="bmodeltest.math.distributions.BMTPrior" count="@hasGammaRates.s:dna" x="@BMT_gammaShape.s:dna">
                    <Exponential id="Exponential.1" name="distr">
                        <mean id="RealScalarParam.16" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="PositiveReal" estimate="false" value="1.0"/>
                    </Exponential>
                </distribution>
                <distribution id="BMT_PropInvariablePrior.s:dna" spec="bmodeltest.math.distributions.BMTPrior" count="@hasInvariableSites.s:dna" x="@BMT_ProportionInvariable.s:dna">
                    <Beta id="Beta.0" name="distr">
                        <alpha id="RealScalarParam.17" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="PositiveReal" value="1.0"/>
                        <beta id="RealScalarParam.18" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="PositiveReal" value="4.0"/>
                    </Beta>
                </distribution>
                <distribution id="BMT_RatesPrior.s:dna" spec="bmodeltest.math.distributions.NucleotideRevJumpSubstModelRatePrior" modelIndicator="@BMT_ModelIndicator.s:dna" x="@BMT_Rates.s:dna">
                    <substModel id="RevJump.s:dna" spec="bmodeltest.evolution.substitutionmodel.NucleotideRevJumpSubstModel" modelIndicator="@BMT_ModelIndicator.s:dna" rates="@BMT_Rates.s:dna">
                        <frequencies id="BMTfreqs.s:dna" spec="bmodeltest.evolution.substitutionmodel.ModelFrequencies" empirical="false" frequencies="@BMT_frequencies.s:dna" hasEqualFreqs="@hasEqualFreqs.s:dna"/>
                    </substModel>
                    <Exponential id="BMT_RatesPrior.s:dnax" name="distr">
                        <mean id="RealScalarParam.15" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="PositiveReal" value="1.0"/>
                    </Exponential>
                </distribution>
                <Dirichlet id="BMT_freqsPrior.s:dna" name="distribution" param="@BMT_frequencies.s:dna">
                    <alpha id="RealVectorParam.0" spec="beast.base.spec.inference.parameter.RealVectorParam" dimension="4" domain="PositiveReal">1.0</alpha>
                </Dirichlet>
                <distribution id="ORCRatePriorDistribution.c:dna" spec="orc.distribution.BranchRatePrior" param="@ORCRates.c:dna" sigma="@ORCsigma.c:dna" tree="@Tree.t:dna"/>
                <Gamma id="ORCsigmaPrior.c:dna" name="distribution" param="@ORCsigma.c:dna">
                    <alpha id="RealScalarParam.13" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="PositiveReal" estimate="false" value="5.0"/>
                    <theta id="RealScalarParam.14" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="PositiveReal" estimate="false" value="0.05"/>
                </Gamma>
                <Uniform id="diversificationRatePriorFBD.t:dna" name="distribution" param="@diversificationRateFBD.t:dna">
                    <upper id="RealScalarParam.86" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="Real" estimate="false" value="10000.0"/>
                </Uniform>
                <Uniform id="originPriorFBD.t:dna" name="distribution" param="@originFBD.t:dna">
                    <upper id="RealScalarParam.85" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="Real" estimate="false" value="10000.0"/>
                </Uniform>
                <Uniform id="samplingProportionPriorFBD.t:dna" name="distribution" param="@samplingProportionFBD.t:dna"/>
                <Uniform id="turnoverPriorFBD.t:dna" name="distribution" param="@turnoverFBD.t:dna"/>
            </distribution>
            <distribution id="likelihood" spec="CompoundDistribution" useThreads="true">
                <distribution id="treeLikelihood.dna" spec="beast.base.spec.evolution.likelihood.ThreadedTreeLikelihood" data="@dna" tree="@Tree.t:dna">
                    <siteModel id="BEASTModelTest.s:dna" spec="bmodeltest.evolution.sitemodel.BEASTModelTestSiteModel" gammaCategoryCount="4" hasGammaRates="@hasGammaRates.s:dna" hasInvariantSites="@hasInvariableSites.s:dna" proportionInvariant="@BMT_ProportionInvariable.s:dna" shape="@BMT_gammaShape.s:dna" substModel="@RevJump.s:dna">
                        <mutationRate id="BMT_mutationRate.s:dna" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="PositiveReal" estimate="false" value="1.0"/>
                    </siteModel>
                    <branchRateModel id="OptimisedRelaxedClock.c:dna" spec="beast.base.spec.evolution.branchratemodel.UCRelaxedClockModel" rates="@ORCRates.c:dna" tree="@Tree.t:dna">
                        <LogNormal id="ORCLogNormalDistribution.c:dna" S="@ORCsigma.c:dna" meanInRealSpace="true" name="distr">
                            <M id="RealScalarParam.10" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="Real" value="1.0"/>
                        </LogNormal>
                        <clock.rate id="ORCucldMean.c:dna" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="PositiveReal" estimate="false" value="1.0"/>
                    </branchRateModel>
                </distribution>
            </distribution>
        </distribution>
        <operator id="BMT_ModelTestOperator.s:dna" spec="bmodeltest.evolution.operators.BMTMergeSplitOperator" modelIndicator="@BMT_ModelIndicator.s:dna" rates="@BMT_Rates.s:dna" substModel="@RevJump.s:dna" weight="1.0"/>
        <operator id="BMT_Ratescaler.s:dna" spec="bmodeltest.evolution.operators.BMTExchangeOperator" delta="0.15" modelIndicator="@BMT_ModelIndicator.s:dna" rates="@BMT_Rates.s:dna" substModel="@RevJump.s:dna" weight="1.0"/>
        <operator id="BMT_gammaShapeScaler.s:dna" spec="bmodeltest.evolution.operators.BMTScaleOperator" count="@hasGammaRates.s:dna" parameter="@BMT_gammaShape.s:dna" scaleFactor="0.5" weight="0.5"/>
        <operator id="BMT_ProportionInvariableScaler.s:dna" spec="bmodeltest.evolution.operators.BMTScaleOperator" count="@hasInvariableSites.s:dna" parameter="@BMT_ProportionInvariable.s:dna" scaleFactor="0.5" weight="0.5"/>
        <operator id="BMT_hasGammaRatesFlipper.s:dna" spec="bmodeltest.evolution.operators.BMTBirthDeathOperator" count="@hasGammaRates.s:dna" rates="@BMT_gammaShape.s:dna" weight="0.1"/>
        <operator id="BMT_hasInvariableSitesFlipper.s:dna" spec="bmodeltest.evolution.operators.BMTBirthDeathOperator" count="@hasInvariableSites.s:dna" rates="@BMT_ProportionInvariable.s:dna" weight="0.1"/>
        <operator id="BMT_FreqsFlipOperator.s:dna" spec="beast.base.spec.inference.operator.BitFlipOperator" parameter="@hasEqualFreqs.s:dna" weight="0.1"/>
        <operator id="BMT_FrequenciesExchanger.s:dna" spec="beast.base.spec.inference.operator.DeltaExchangeOperator" delta="0.01" weight="0.2">
            <parameter idref="BMT_frequencies.s:dna"/>
        </operator>
        <operator id="ORCAdaptableOperatorSampler_sigma.c:dna" spec="beast.base.spec.evolution.operator.AdaptableOperatorSampler" weight="3.0">
            <parameter idref="ORCsigma.c:dna"/>
            <operator id="ORCUcldStdevScale.c:dna" spec="beast.base.spec.inference.operator.ScaleOperator" parameter="@ORCsigma.c:dna" scaleFactor="0.5" weight="1.0">
                <kernelDistribution id="KernelDistribution$Bactrian.13" spec="operator.kernel.KernelDistribution$Bactrian"/>
            </operator>
            <operator id="ORCSampleFromPriorOperator_sigma.c:dna" spec="orc.operators.SampleFromPriorOperator" parameter="@ORCsigma.c:dna" prior="@ORCsigmaPrior.c:dna" weight="1.0"/>
        </operator>
        <operator id="ORCAdaptableOperatorSampler_rates_root.c:dna" spec="beast.base.spec.evolution.operator.AdaptableOperatorSampler" weight="1.0">
            <parameter idref="ORCRates.c:dna"/>
            <tree idref="Tree.t:dna"/>
            <operator id="ORCRootOperator1.c:dna" spec="orc.consoperators.SimpleDistance" clockModel="@OptimisedRelaxedClock.c:dna" rates="@ORCRates.c:dna" tree="@Tree.t:dna" twindowSize="0.005" weight="1.0">
                <kernel id="KernelDistribution$Bactrian.14" spec="operator.kernel.KernelDistribution$Bactrian"/>
            </operator>
            <operator id="ORCRootOperator2.c:dna" spec="orc.consoperators.SmallPulley" clockModel="@OptimisedRelaxedClock.c:dna" dwindowSize="0.005" rates="@ORCRates.c:dna" tree="@Tree.t:dna" weight="1.0">
                <kernel id="KernelDistribution$Bactrian.15" spec="operator.kernel.KernelDistribution$Bactrian"/>
            </operator>
        </operator>
        <operator id="ORCAdaptableOperatorSampler_rates_internal.c:dna" spec="beast.base.spec.evolution.operator.AdaptableOperatorSampler" weight="20.0">
            <parameter idref="ORCRates.c:dna"/>
            <tree idref="Tree.t:dna"/>
            <operator id="ORCInternalnodesOperator.c:dna" spec="orc.consoperators.InConstantDistanceOperator" clockModel="@OptimisedRelaxedClock.c:dna" rates="@ORCRates.c:dna" tree="@Tree.t:dna" twindowSize="0.005" weight="1.0">
                <kernel id="KernelDistribution$Bactrian.16" spec="operator.kernel.KernelDistribution$Bactrian"/>
            </operator>
            <operator id="ORCRatesScale.c:dna" spec="beast.base.spec.inference.operator.ScaleOperator" parameter="@ORCRates.c:dna" scaleFactor="0.5" weight="1.0">
                <kernelDistribution id="KernelDistribution$Bactrian.17" spec="operator.kernel.KernelDistribution$Bactrian"/>
            </operator>
            <operator id="ORCSampleFromPriorOperator.rates.c:dna" spec="orc.operators.SampleFromPriorOperator" parameter="@ORCRates.c:dna" prior="@ORCRatePriorDistribution.c:dna" weight="1.0"/>
        </operator>
        <operator id="ORCNER_dAE_dBE_dCE.c:dna" spec="orc.ner.NEROperator_dAE_dBE_dCE" rates="@ORCRates.c:dna" tree="@Tree.t:dna" weight="5.0"/>
        <operator id="originScalerFBD.t:dna" spec="beast.base.spec.inference.operator.ScaleOperator" parameter="@originFBD.t:dna" weight="3.0"/>
        <operator id="divRateScalerFBD.t:dna" spec="beast.base.spec.inference.operator.ScaleOperator" parameter="@diversificationRateFBD.t:dna" weight="10.0"/>
        <operator id="turnoverScalerFBD.t:dna" spec="beast.base.spec.inference.operator.ScaleOperator" parameter="@turnoverFBD.t:dna" weight="10.0"/>
        <operator id="samplingPScalerFBD.t:dna" spec="beast.base.spec.inference.operator.ScaleOperator" parameter="@samplingProportionFBD.t:dna" weight="10.0"/>
        <operator id="LeafToSAFBD.t:dna" spec="sa.evolution.operators.LeafToSampledAncestorJump" tree="@Tree.t:dna" weight="10.0"/>
        <operator id="SAWilsonBaldingFBD.t:dna" spec="sa.evolution.operators.SAWilsonBalding" tree="@Tree.t:dna" weight="10.0"/>
        <operator id="SAWideFBD.t:dna" spec="sa.evolution.operators.SAExchange" isNarrow="false" tree="@Tree.t:dna" weight="10.0"/>
        <operator id="SANarrowFBD.t:dna" spec="sa.evolution.operators.SAExchange" tree="@Tree.t:dna" weight="10.0"/>
        <operator id="SAUniformOperatorFBD.t:dna" spec="sa.evolution.operators.SAUniform" tree="@Tree.t:dna" weight="20.0"/>
        <operator id="SATreeRootScalerFBD.t:dna" spec="sa.evolution.operators.SAScaleOperator" rootOnly="true" scaleFactor="0.95" tree="@Tree.t:dna" weight="1.0"/>
        <operator id="SATreeScalerFBD.t:dna" spec="sa.evolution.operators.SAScaleOperator" scaleFactor="0.95" tree="@Tree.t:dna" weight="3.0"/>
        <logger id="tracelog" spec="Logger" fileName="$(filebase).log" logEvery="4000" model="@posterior" sanitiseHeaders="true" sort="smart">
            <log idref="posterior"/>
            <log idref="likelihood"/>
            <log idref="prior"/>
            <log idref="treeLikelihood.dna"/>
            <log id="TreeHeight.t:dna" spec="beast.base.evolution.tree.TreeStatLogger" tree="@Tree.t:dna"/>
            <log idref="RevJump.s:dna"/>
            <log idref="BMT_ModelIndicator.s:dna"/>
            <log idref="BMT_gammaShape.s:dna"/>
            <log idref="BMT_ProportionInvariable.s:dna"/>
            <log idref="hasGammaRates.s:dna"/>
            <log idref="hasInvariableSites.s:dna"/>
            <log id="ActivePropInvariable.s:dna" spec="bmodeltest.evolution.substitutionmodel.ActiveLogger" mask="@hasInvariableSites.s:dna" parameter="@BMT_ProportionInvariable.s:dna"/>
            <log id="ActiveGammaShape.s:dna" spec="bmodeltest.evolution.substitutionmodel.ActiveLogger" mask="@hasGammaRates.s:dna" parameter="@BMT_gammaShape.s:dna"/>
            <log idref="hasEqualFreqs.s:dna"/>
            <log idref="BMT_frequencies.s:dna"/>
            <log idref="ORCsigma.c:dna"/>
            <log id="ORCRatesStat.c:dna" spec="beast.base.evolution.RateStatistic" branchratemodel="@OptimisedRelaxedClock.c:dna" tree="@Tree.t:dna"/>
            <log idref="FBD.t:dna"/>
            <log idref="diversificationRateFBD.t:dna"/>
            <log idref="turnoverFBD.t:dna"/>
            <log idref="samplingProportionFBD.t:dna"/>
            <log idref="originFBD.t:dna"/>
            <log id="SACountFBD.t:dna" spec="sa.evolution.tree.SampledAncestorLogger" tree="@Tree.t:dna"/>
        </logger>
        <logger id="screenlog" spec="Logger" logEvery="4000">
            <log idref="posterior"/>
            <log idref="likelihood"/>
            <log idref="prior"/>
        </logger>
        <logger id="treelog.t:dna" spec="Logger" fileName="$(filebase)-$(tree).trees" logEvery="4000" mode="tree">
            <log id="TreeWithMetaDataLogger.t:dna" spec="beast.base.spec.evolution.TreeWithMetaDataLogger" branchratemodel="@OptimisedRelaxedClock.c:dna" tree="@Tree.t:dna"/>
        </logger>
        <operatorschedule id="OperatorSchedule" spec="OperatorSchedule"/>
    </run>

</beast>
