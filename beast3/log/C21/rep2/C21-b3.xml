        <init id="RandomTree.t:E15-binary" spec="beast.base.spec.evolution.tree.coalescent.RandomTree" estimate="false" initial="@Tree.t:E15-binary" taxa="@E15-binary">
            <populationModel id="ConstantPopulation0.t:E15-binary" spec="beast.base.spec.evolution.tree.coalescent.ConstantPopulation">
                <popSize id="randomPopSize.t:E15-binary" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="PositiveReal" value="1.0"/>
            </populationModel>
        </init>
        <distribution id="posterior" spec="CompoundDistribution">
            <distribution id="prior" spec="CompoundDistribution">
                <distribution id="YuleModel.t:E15-binary" spec="beast.base.spec.evolution.speciation.YuleModel" birthDiffRate="@birthRate.t:E15-binary" tree="@Tree.t:E15-binary"/>
                <Gamma id="YuleBirthRatePrior.t:E15-binary" name="distribution" param="@birthRate.t:E15-binary">
                    <alpha id="RealScalarParam.2" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="Real" estimate="false" value="0.01"/>
                    <theta id="RealScalarParam.3" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="PositiveReal" estimate="false" value="100.0"/>
                </Gamma>
            </distribution>
            <distribution id="likelihood" spec="CompoundDistribution" useThreads="true">
                <distribution id="treeLikelihood.E15-binary" spec="beast.base.spec.evolution.likelihood.ThreadedTreeLikelihood" data="@E15-binary" tree="@Tree.t:E15-binary">
                    <siteModel id="SiteModel.s:E15-binary" spec="beast.base.spec.evolution.sitemodel.SiteModel">
                        <mutationRate id="mutationRate.s:E15-binary" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="PositiveReal" estimate="false" value="1.0"/>
                        <shape id="gammaShape.s:E15-binary" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="PositiveReal" estimate="false" value="1.0"/>
                        <proportionInvariant id="proportionInvariant.s:E15-binary" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="UnitInterval" estimate="false"/>
                        <substModel id="MutationDeathModel.s:E15-binary" spec="beast.base.spec.evolution.substitutionmodel.MutationDeathModel">
                            <deathprob id="deathprob.s:E15-binary" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="PositiveReal" estimate="false" value="0.1"/>
                            <frequencies id="freqs.s:E15-binary" spec="beast.base.spec.evolution.substitutionmodel.Frequencies">
                                <frequencies id="SimplexParam.0" spec="beast.base.spec.inference.parameter.SimplexParam" dimension="2" domain="UnitInterval">1.0 0.0</frequencies>
                            </frequencies>
                        </substModel>
                    </siteModel>
                    <branchRateModel id="StrictClock.c:E15-binary" spec="beast.base.spec.evolution.branchratemodel.StrictClockModel">
                        <clock.rate id="clockRate.c:E15-binary" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="PositiveReal" estimate="false" value="1.0"/>
                    </branchRateModel>
                </distribution>
            </distribution>
        </distribution>
        <operator id="YuleBirthRateScaler.t:E15-binary" spec="beast.base.spec.inference.operator.ScaleOperator" parameter="@birthRate.t:E15-binary" weight="3.0"/>
        <operator id="YuleModelTreeRootScaler.t:E15-binary" spec="beast.base.spec.evolution.operator.ScaleTreeOperator" rootOnly="true" scaleFactor="0.5" tree="@Tree.t:E15-binary" weight="3.0"/>
        <operator id="YuleModelUniformOperator.t:E15-binary" spec="kernel.BactrianNodeOperator" tree="@Tree.t:E15-binary" weight="30.0"/>
        <operator id="YuleModelSubtreeSlide.t:E15-binary" spec="kernel.BactrianSubtreeSlide" tree="@Tree.t:E15-binary" weight="15.0"/>
        <operator id="YuleModelNarrow.t:E15-binary" spec="Exchange" tree="@Tree.t:E15-binary" weight="15.0"/>
        <operator id="YuleModelWide.t:E15-binary" spec="Exchange" isNarrow="false" tree="@Tree.t:E15-binary" weight="3.0"/>
        <operator id="YuleModelWilsonBalding.t:E15-binary" spec="WilsonBalding" tree="@Tree.t:E15-binary" weight="3.0"/>
        <operator id="YuleModelTreeScaler.t:E15-binary" spec="beast.base.spec.evolution.operator.UpDownOperator" scaleFactor="0.1" weight="4.0">
