            <log idref="likelihood"/>
            <log idref="prior"/>
            <log idref="treeLikelihood.E15-binary"/>
            <log id="TreeHeight.t:E15-binary" spec="beast.base.evolution.tree.TreeStatLogger" tree="@Tree.t:E15-binary"/>
            <log idref="YuleModel.t:E15-binary"/>
            <log idref="birthRate.t:E15-binary"/>
        </logger>
        <logger id="screenlog" spec="Logger" logEvery="1000">
            <log idref="posterior"/>
            <log idref="likelihood"/>
            <log idref="prior"/>
        </logger>
        <logger id="treelog.t:E15-binary" spec="Logger" fileName="$(filebase)-$(tree).trees" logEvery="1000" mode="tree">
