            <operator id="AVMNOperator.aminoacid" spec="beast.base.spec.evolution.operator.AdaptableVarianceMultivariateNormalOperator" allowNonsense="true" beta="0.05" burnin="400" initial="800" weight="0.1">
                <transformations id="AVMNSumTransform.aminoacid" spec="beast.base.spec.inference.operator.Transform$LogConstrainedSumTransform"/>
                <transformations id="AVMNLogTransform.aminoacid" spec="beast.base.spec.inference.operator.Transform$LogTransform">
                    <f idref="gammaShape.s:aminoacid"/>
                </transformations>
                <transformations id="AVMNNoTransform.aminoacid" spec="beast.base.spec.inference.operator.Transform$NoTransform"/>
            </operator>
            <operator id="gammaShapeScalerX.s:aminoacid" spec="beast.base.spec.inference.operator.ScaleOperator" parameter="@gammaShape.s:aminoacid" scaleFactor="0.5" weight="0.1"/>
        </operator>
        <operator id="CoalescentConstantTreeScaler.t:aminoacid" spec="beast.base.spec.evolution.operator.UpDownOperator" scaleFactor="0.1" weight="4.0">
            <up idref="Tree.t:aminoacid"/>
        </operator>
        <operator id="CoalescentConstantTreeRootScaler.t:aminoacid" spec="kernel.BactrianScaleOperator" rootOnly="true" scaleFactor="0.1" tree="@Tree.t:aminoacid" upper="10.0" weight="3.0"/>
        <operator id="CoalescentConstantUniformOperator.t:aminoacid" spec="kernel.BactrianNodeOperator" tree="@Tree.t:aminoacid" weight="30.0"/>
        <operator id="CoalescentConstantSubtreeSlide.t:aminoacid" spec="kernel.BactrianSubtreeSlide" tree="@Tree.t:aminoacid" weight="15.0"/>
        <operator id="CoalescentConstantNarrow.t:aminoacid" spec="Exchange" tree="@Tree.t:aminoacid" weight="15.0"/>
        <operator id="CoalescentConstantWide.t:aminoacid" spec="Exchange" isNarrow="false" tree="@Tree.t:aminoacid" weight="3.0"/>
        <operator id="CoalescentConstantWilsonBalding.t:aminoacid" spec="WilsonBalding" tree="@Tree.t:aminoacid" weight="3.0"/>
        <operator id="PopSizeScaler.t:aminoacid" spec="beast.base.spec.inference.operator.ScaleOperator" parameter="@popSize.t:aminoacid" weight="3.0"/>
        <logger id="tracelog" spec="Logger" fileName="$(filebase).log" logEvery="1000" model="@posterior" sanitiseHeaders="true" sort="smart">
