                    <treeIntervals id="TreeIntervals.t:aminoacid" spec="beast.base.evolution.tree.TreeIntervals" tree="@Tree.t:aminoacid"/>
                </distribution>
                <Exponential id="GammaShapePrior.s:aminoacid" name="distribution" param="@gammaShape.s:aminoacid">
                    <mean id="RealScalarParam.46" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="PositiveReal" estimate="false" value="1.0"/>
                </Exponential>
                <LogNormal id="PopSizePrior.t:aminoacid" name="distribution" param="@popSize.t:aminoacid">
                    <M id="RealScalarParam.92" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="Real" estimate="false" value="1.0"/>
                    <S id="RealScalarParam.93" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="PositiveReal" estimate="false" value="1.25"/>
                </LogNormal>
            </distribution>
            <distribution id="likelihood" spec="CompoundDistribution" useThreads="true">
                <distribution id="treeLikelihood.aminoacid" spec="beast.base.spec.evolution.likelihood.ThreadedTreeLikelihood" data="@aminoacid" tree="@Tree.t:aminoacid">
                    <siteModel id="SiteModel.s:aminoacid" spec="beast.base.spec.evolution.sitemodel.SiteModel" gammaCategoryCount="4" shape="@gammaShape.s:aminoacid">
                        <mutationRate id="mutationRate.s:aminoacid" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="PositiveReal" estimate="false" value="1.0"/>
                        <proportionInvariant id="proportionInvariant.s:aminoacid" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="UnitInterval" estimate="false"/>
