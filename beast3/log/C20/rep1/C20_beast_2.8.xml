                    </siteModel>
                    <branchRateModel id="StrictClock.c:aminoacid" spec="beast.base.spec.evolution.branchratemodel.StrictClockModel">
                        <clock.rate id="clockRate.c:aminoacid" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="PositiveReal" estimate="false" value="1.0"/>
                    </branchRateModel>
                </distribution>
            </distribution>
        </distribution>
        <operator id="gammaShapeScaler.s:aminoacid" spec="beast.base.spec.evolution.operator.AdaptableOperatorSampler" weight="0.05">
