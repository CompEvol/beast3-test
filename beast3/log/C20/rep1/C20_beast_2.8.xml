            </tree>
            <stateNode id="gammaShape.s:aminoacid" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="PositiveReal" value="1.0"/>
            <stateNode id="popSize.t:aminoacid" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="PositiveReal" value="0.3"/>
        </state>
        <init id="RandomTree.t:aminoacid" spec="beast.base.spec.evolution.tree.coalescent.RandomTree" estimate="false" initial="@Tree.t:aminoacid" taxa="@aminoacid">
            <populationModel id="ConstantPopulation0.t:aminoacid" spec="beast.base.spec.evolution.tree.coalescent.ConstantPopulation">
                <popSize id="randomPopSize.t:aminoacid" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="PositiveReal" value="1.0"/>
