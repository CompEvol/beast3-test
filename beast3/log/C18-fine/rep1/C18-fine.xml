    <run id="mcmc" spec="MCMC" chainLength="10000000">
        <state id="state" spec="State" storeEvery="5000">
            <tree id="Tree.t:protein" spec="beast.base.evolution.tree.Tree" name="stateNode">
                <taxonset id="TaxonSet.protein" spec="TaxonSet">
                    <alignment idref="protein"/>
                </taxonset>
            </tree>
            <stateNode id="birthRate.t:protein" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="PositiveReal" value="1.0"/>
            <stateNode id="gammaShape.s:protein" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="PositiveReal" value="1.0"/>
        </state>
        <init id="RandomTree.t:protein" spec="beast.base.spec.evolution.tree.coalescent.RandomTree" estimate="false" initial="@Tree.t:protein" taxa="@protein">
            <populationModel id="ConstantPopulation0.t:protein" spec="beast.base.spec.evolution.tree.coalescent.ConstantPopulation">
                <popSize id="randomPopSize.t:protein" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="PositiveReal" value="1.0"/>
            </populationModel>
        </init>
        <distribution id="posterior" spec="CompoundDistribution">
            <distribution id="prior" spec="CompoundDistribution">
                <distribution id="YuleModel.t:protein" spec="beast.base.spec.evolution.speciation.YuleModel" birthDiffRate="@birthRate.t:protein" tree="@Tree.t:protein"/>
                <TruncatedReal id="GammaShapePrior.s:protein" name="distribution" param="@gammaShape.s:protein">
                    <Exponential id="Exponential.0" name="distribution">
                        <mean id="RealScalarParam.6" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="PositiveReal" estimate="false" value="1.0"/>
                    </Exponential>
                    <lower id="RealScalarParam.7" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="Real" estimate="false" value="0.1"/>
                </TruncatedReal>
                <Gamma id="YuleBirthRatePrior.t:protein" name="distribution" param="@birthRate.t:protein">
                    <alpha id="RealScalarParam.2" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="Real" estimate="false" value="0.01"/>
                    <theta id="RealScalarParam.3" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="PositiveReal" estimate="false" value="100.0"/>
                </Gamma>
            </distribution>
            <distribution id="likelihood" spec="CompoundDistribution" useThreads="true">
                <distribution id="treeLikelihood.protein" spec="beast.base.spec.evolution.likelihood.ThreadedTreeLikelihood" data="@protein" tree="@Tree.t:protein">
                    <siteModel id="SiteModel.s:protein" spec="beast.base.spec.evolution.sitemodel.SiteModel" gammaCategoryCount="4" shape="@gammaShape.s:protein">
                        <mutationRate id="mutationRate.s:protein" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="PositiveReal" estimate="false" value="1.0"/>
                        <proportionInvariant id="proportionInvariant.s:protein" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="UnitInterval" estimate="false"/>
                        <substModel id="WAG.s:protein" spec="beast.base.spec.evolution.substitutionmodel.WAG"/>
                    </siteModel>
                    <branchRateModel id="StrictClock.c:protein" spec="beast.base.spec.evolution.branchratemodel.StrictClockModel">
                        <clock.rate id="clockRate.c:protein" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="PositiveReal" estimate="false" value="1.0"/>
                    </branchRateModel>
                </distribution>
            </distribution>
        </distribution>
        <operator id="YuleBirthRateScaler.t:protein" spec="beast.base.spec.inference.operator.ScaleOperator" parameter="@birthRate.t:protein" weight="3.0"/>
        <operator id="YuleModelTreeRootScaler.t:protein" spec="beast.base.spec.evolution.operator.ScaleTreeOperator" rootOnly="true" scaleFactor="0.5" tree="@Tree.t:protein" weight="3.0"/>
        <operator id="YuleModelUniformOperator.t:protein" spec="kernel.BactrianNodeOperator" tree="@Tree.t:protein" weight="30.0"/>
        <operator id="YuleModelSubtreeSlide.t:protein" spec="kernel.BactrianSubtreeSlide" tree="@Tree.t:protein" weight="15.0"/>
        <operator id="YuleModelNarrow.t:protein" spec="Exchange" tree="@Tree.t:protein" weight="15.0"/>
        <operator id="YuleModelWide.t:protein" spec="Exchange" isNarrow="false" tree="@Tree.t:protein" weight="3.0"/>
        <operator id="YuleModelWilsonBalding.t:protein" spec="WilsonBalding" tree="@Tree.t:protein" weight="3.0"/>
        <operator id="YuleModelTreeScaler.t:protein" spec="beast.base.spec.evolution.operator.UpDownOperator" scaleFactor="0.1" weight="4.0">
            <up idref="Tree.t:protein"/>
        </operator>
        <operator id="gammaShapeScaler.s:protein" spec="beast.base.spec.evolution.operator.AdaptableOperatorSampler" weight="0.05">
            <parameter idref="gammaShape.s:protein"/>
            <operator id="AVMNOperator.protein" spec="beast.base.spec.evolution.operator.AdaptableVarianceMultivariateNormalOperator" allowNonsense="true" beta="0.05" burnin="400" initial="800" weight="0.1">
                <transformations id="AVMNSumTransform.protein" spec="beast.base.spec.inference.operator.Transform$LogConstrainedSumTransform"/>
                <transformations id="AVMNLogTransform.protein" spec="beast.base.spec.inference.operator.Transform$LogTransform">
                    <scalable idref="Tree.t:protein"/>
                    <f idref="gammaShape.s:protein"/>
                </transformations>
                <transformations id="AVMNNoTransform.protein" spec="beast.base.spec.inference.operator.Transform$NoTransform"/>
            </operator>
            <operator id="gammaShapeScalerX.s:protein" spec="beast.base.spec.inference.operator.ScaleOperator" parameter="@gammaShape.s:protein" scaleFactor="0.5" weight="0.1"/>
        </operator>
        <logger id="tracelog" spec="Logger" fileName="$(filebase).log" logEvery="100" model="@posterior" sanitiseHeaders="true" sort="smart">
            <log idref="posterior"/>
            <log idref="likelihood"/>
            <log idref="prior"/>
            <log idref="treeLikelihood.protein"/>
            <log id="TreeHeight.t:protein" spec="beast.base.evolution.tree.TreeStatLogger" tree="@Tree.t:protein"/>
            <log idref="YuleModel.t:protein"/>
            <log idref="birthRate.t:protein"/>
            <log idref="gammaShape.s:protein"/>
        </logger>
        <logger id="screenlog" spec="Logger" logEvery="1000">
            <log idref="posterior"/>
            <log idref="likelihood"/>
            <log idref="prior"/>
        </logger>
        <logger id="treelog.t:protein" spec="Logger" fileName="$(filebase)-$(tree).trees" logEvery="1000" mode="tree">
            <log id="TreeWithMetaDataLogger.t:protein" spec="beast.base.spec.evolution.TreeWithMetaDataLogger" tree="@Tree.t:protein"/>
        </logger>
        <operatorschedule id="OperatorSchedule" spec="OperatorSchedule"/>
    </run>

